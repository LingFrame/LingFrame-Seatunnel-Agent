{
  "env": {"job.name": "mysql2kafka_sql", "job.mode": "BATCH"},
  "source": [{"plugin_name": "Jdbc", "url": "jdbc:mysql://mysql-server:3306/test?useSSL=false&allowPublicKeyRetrieval=true", "driver": "com.mysql.cj.jdbc.Driver", "user": "root", "password": "root", "query": "SELECT id, name, score FROM t_source", "plugin_output": "t_src", "schema": {"fields": {"id": "int", "name": "string", "score": "double"}}}],
  "transform": [{"plugin_name": "Sql", "plugin_input": "t_src", "plugin_output": "t_mid", "query": "select id, name, score from dual where id > 0"}],
  "sink": [{"plugin_name": "Kafka", "plugin_input": "t_mid", "topic": "test-topic-1", "bootstrap.servers": "kafka-server:9092", "format": "json"}]
}