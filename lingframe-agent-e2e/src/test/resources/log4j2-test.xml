<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <!-- 控制台输出 -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>

        <!-- 物理文件落盘：无论控制台是否被拦截，本地日志永远 100% 完整保留 -->
        <File name="AuditFile" fileName="target/logs/metaspace-audit.log" append="false">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </File>
    </Appenders>

    <Loggers>
        <!-- 重点放行 LingFrame 框架与 E2E 测试自身的核心演进与审计日志 -->
        <Logger name="com.lingframe" level="INFO"/>

        <!-- 压制第三方中间件与底座噪音 -->
        <Logger name="org.apache.seatunnel" level="WARN"/>
        <Logger name="org.apache.kafka" level="WARN"/>
        <Logger name="com.hazelcast" level="WARN"/>

        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AuditFile"/>
        </Root>
    </Loggers>
</Configuration>
