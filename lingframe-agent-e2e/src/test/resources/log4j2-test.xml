<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>

        <File name="AuditFile" fileName="target/logs/metaspace-audit.log" append="false">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </File>
    </Appenders>

    <Loggers>
        <!-- 压制框架流水线 Trace 与内部事件，坚决防止万行日志刷屏 -->
        <Logger name="com.lingframe" level="WARN"/>

        <!-- 仅对 MetaspaceLeakIT 核心测试类放行 INFO 并显式双写，不依赖隐式冒泡，确保纯净输出演进与最终报表 -->
        <Logger name="com.lingframe.agent.e2e.MetaspaceLeakIT" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AuditFile"/>
        </Logger>

        <!-- 压制第三方中间件噪音 -->
        <Logger name="org.apache.seatunnel" level="WARN"/>
        <Logger name="org.apache.kafka" level="WARN"/>
        <Logger name="com.hazelcast" level="WARN"/>

        <Root level="WARN">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AuditFile"/>
        </Root>
    </Loggers>
</Configuration>
